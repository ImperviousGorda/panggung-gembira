{
  "entities": {
    "reviews": {
      "title": "Reviews and Suggestions",
      "description": "User reviews and suggestions for Panggung Gembira",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["ulasan", "saran"] },
        "time": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "role", "rating", "text", "type"]
    },
    "contacts": {
      "title": "Contact Messages",
      "description": "Messages sent through the contact form",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["fullName", "email", "message"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Collection storing public audience reviews and suggestions"
    },
    "/contacts/{contactId}": {
      "schema": "contacts",
      "description": "Collection storing messages sent via contact form"
    }
  }
}
